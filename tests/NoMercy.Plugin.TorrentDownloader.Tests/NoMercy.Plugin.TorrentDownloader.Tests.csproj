<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shell, against a fake host. Still no network.

    It also holds the health tool's tests. The tool is where that judgement
    lives — what a source answered, and whether the reader saw it — and it sits
    on top of the shell's fetch, so its tests belong on this side of the wall
    rather than in Core, which cannot see either.
  -->

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NoMercy.Plugin.TorrentDownloader\NoMercy.Plugin.TorrentDownloader.csproj" />
    <ProjectReference Include="..\..\tools\SourceHealth\SourceHealth.csproj" />
  </ItemGroup>

</Project>
