<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <!-- Clear first: a source inherited from a machine-wide config decides what
         this build restores, and nobody reading this file would know. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- The plugin contract is not published anywhere. scripts/fetch-abstractions
         packs it out of the media server into this folder. -->
    <add key="nomercy-local" value="_nupkgs" />
  </packageSources>

  <packageSourceMapping>
    <!-- No mapping, so both sources are searched. Cleared for the same reason as
         above: an inherited mapping would silently hide _nupkgs. -->
    <clear />
  </packageSourceMapping>

  <auditSources>
    <!-- Audit warnings are build errors here (TreatWarningsAsErrors), so a new
         advisory published against a transitive package would break a build that
         changed nothing. Vulnerabilities are handled by upgrading deliberately. -->
    <clear />
  </auditSources>

</configuration>
