<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nm-ui-preview" value="C:/Projects/StoneyEagle/.nm-plugin-feed" />
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="./_nupkgs" />
  </packageSources>

  <!--
    NoMercy.* resolves from the local feed and nowhere else.

    Without this, the shell's floating PackageReference picks the highest matching
    version across EVERY enabled source. NoMercy.Plugins.Abstractions is unclaimed on
    nuget.org - which is the whole reason scripts/fetch-abstractions.* exists - so
    anyone publishing that name at a higher version would get their assembly compiled
    into this plugin in place of the host's real contract.
  -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="NoMercy.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
