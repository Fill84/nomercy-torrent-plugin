<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Walks every enabled source through the same catalogue, the same fetch and
    the same readers the plugin uses, and writes down what each one answered.
    The judgement it makes is in SourceCheck rather than in Program, so it can
    be tested against real captured pages instead of against the internet.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NoMercy.Plugin.TorrentDownloader.Tools.SourceHealth</RootNamespace>
    <AssemblyName>SourceHealth</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NoMercy.Plugin.TorrentDownloader\NoMercy.Plugin.TorrentDownloader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
