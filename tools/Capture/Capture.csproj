<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Saves a real page into tests/fixtures/, through the same catalogue, the same
    fetch and the same solver the plugin uses. A capture taken any other way is
    a page the plugin has never actually seen.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NoMercy.Plugin.TorrentDownloader.Tools.Capture</RootNamespace>
    <AssemblyName>Capture</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NoMercy.Plugin.TorrentDownloader\NoMercy.Plugin.TorrentDownloader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
