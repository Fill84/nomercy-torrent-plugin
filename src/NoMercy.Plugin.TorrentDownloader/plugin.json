{
  "id": "1SBQT26FHF98EBRPYVRGD92CZF",
  "name": "Torrent Downloader",
  "description": "Downloads every episode missing from a TV or anime library and hands it to the encoder.",
  "version": "0.6.6",
  "targetAbi": "12.0",
  "assembly": "NoMercy.Plugin.TorrentDownloader.dll",
  "autoEnabled": true,
  "capabilities": {
    "hooks": [
      "scheduledTask",
      "ui",
      "encoder"
    ],
    "rest": true,
    "ws": false,
    "network": {
      "hosts": [
        "predb.me",
        "www.srrdb.com",
        "api.srrdb.com",
        "www.scnsrc.me",
        "eztv.re",
        "apibay.org",
        "www.1337x.to",
        "www.limetorrents.fun",
        "extranet.torrentbay.st",
        "eztvx.to",
        "torrentgalaxy.one",
        "torrentz2.nz",
        "www.torrentdownloads.pro",
        "nyaa.si",
        "yts.gg",
        "api.predb.net"
      ]
    },
    "ui": {
      "mounts": [
        {
          "section": "dashboard",
          "route": "/",
          "label": "Torrent Downloader",
          "icon": "download"
        },
        {
          "section": "settings",
          "route": "/settings",
          "label": "Torrent Downloader",
          "icon": "download"
        }
      ]
    }
  }
}
