<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This assembly is loaded by the host out of its own folder, not run, and a
      class library's build does not copy the packages it depends on into its
      output. Without this the folder holds three assemblies and a manifest
      naming twelve, the host's resolver finds nothing beside the plugin, and
      GetTypes throws before a single type is read.

      That is not a plugin that misbehaves: PluginLoader's
      ReflectionTypeLoadException path reports the failure and returns without
      registering anything, so the plugin is simply absent from the server's
      list with no sign of why.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!--
    The shell: everything that touches the host. Wiring, the library adapter,
    encode dispatch, grants, the solver, storage, the pages and the endpoints.
    This is the only project that is allowed to know a media server exists.
  -->

  <ItemGroup>
    <!--
      The manifest ships beside the assembly and is read by the server before
      any of this code runs. It travels into the output of whatever references
      this project too, so a test reads the copy that would actually deploy.
    -->
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      Beside the assembly, and read from the assembly's own folder rather than
      from AppContext.BaseDirectory — which, for a plugin loaded into the
      server's process, is the server's folder. That mistake cost 0.3.4 fourteen
      of its seventeen sources for a day, silently.
    -->
    <None Update="sources.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Plugin.TorrentDownloader.Core\NoMercy.Plugin.TorrentDownloader.Core.csproj" />
    <ProjectReference Include="..\NoMercy.Plugin.TorrentDownloader.Bittorrent\NoMercy.Plugin.TorrentDownloader.Bittorrent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not on nuget.org. scripts/fetch-abstractions packs both out of the media
      server on branch dev into _nupkgs/. docs/01-plugin.md § Building against
      the contract.
    -->
    <PackageReference Include="NoMercy.Plugins.Abstractions" Version="$(NoMercyContractVersion)" />
    <PackageReference Include="NoMercy.Plugins.Mvc" Version="$(NoMercyContractVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The browser driver. docs/01-plugin.md § Deploying already says "the
      browser driver's assemblies" travel with the plugin, so one was always
      expected; this is the one that phrase was written about.

      It connects to a browser this plugin started, and never launches one
      itself: the browser has to come up on a hidden stage, which is something
      no driver knows how to do.
    -->
    <PackageReference Include="PuppeteerSharp" Version="25.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The plugin's own store. A JSON file was 0.3.4's and is the wrong shape:
      every write rewrites everything, two cadences writing at once lose each
      other's work, and asking what is still missing means loading all of it.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Read out of the assembly rather than from beside it: a migration that
      failed to deploy would otherwise look exactly like a database that was
      already up to date.
    -->
    <EmbeddedResource Include="Storage\Migrations\*.sql" />
  </ItemGroup>

</Project>
