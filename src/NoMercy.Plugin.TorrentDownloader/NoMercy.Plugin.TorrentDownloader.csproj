<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      This assembly is loaded by the host out of its own folder, not run, and a
      class library's build does not copy the packages it depends on into its
      output. Without this the folder holds three assemblies and a manifest
      naming twelve, the host's resolver finds nothing beside the plugin, and
      GetTypes throws before a single type is read.

      That is not a plugin that misbehaves: PluginLoader's
      ReflectionTypeLoadException path reports the failure and returns without
      registering anything, so the plugin is simply absent from the server's
      list with no sign of why.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!--
    The shell: everything that touches the host. Wiring, the library adapter,
    encode dispatch, grants, the solver, storage, the pages and the endpoints.
    This is the only project that is allowed to know a media server exists.
  -->

  <ItemGroup>
    <!--
      The manifest ships beside the assembly and is read by the server before
      any of this code runs. It travels into the output of whatever references
      this project too, so a test reads the copy that would actually deploy.
    -->
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoMercy.Plugin.TorrentDownloader.Core\NoMercy.Plugin.TorrentDownloader.Core.csproj" />
    <ProjectReference Include="..\NoMercy.Plugin.TorrentDownloader.Bittorrent\NoMercy.Plugin.TorrentDownloader.Bittorrent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not on nuget.org until a server release publishes them, and none with
      the renamed contract has. scripts/fetch-abstractions packs both out of
      the media server on branch dev into _nupkgs/. docs/01-plugin.md
      § Building against the contract.
    -->
    <PackageReference Include="NoMercy.PluginSdk.Abstractions" Version="$(NoMercyContractVersion)" />
    <PackageReference Include="NoMercy.PluginSdk.Mvc" Version="$(NoMercyContractVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The browser driver. docs/01-plugin.md § Deploying already says "the
      browser driver's assemblies" travel with the plugin, so one was always
      expected; this is the one that phrase was written about.

      It connects to a browser this plugin started, and never launches one
      itself: the browser has to come up on a hidden stage, which is something
      no driver knows how to do.
    -->
    <PackageReference Include="PuppeteerSharp" Version="25.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The plugin's own store. A JSON file was 0.3.4's and is the wrong shape:
      every write rewrites everything, two cadences writing at once lose each
      other's work, and asking what is still missing means loading all of it.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!--
    The source catalogue and the migrations travel inside the assembly, as code
    this step writes from the files people edit and tools read.

    Not beside it: a catalogue read from beside the assembly has to ask the
    assembly where it is (Assembly.Location), and one looked for in the wrong
    folder cost 0.3.4 fourteen of its seventeen sources for a day, silently (C1).
    Not as embedded resources either: reading those needs
    Assembly.GetManifestResourceStream. The marketplace scan refuses
    System.Reflection.Assembly (media-server #476), and code needs neither.

    Escaped, because MSBuild would otherwise split the files at every semicolon.
  -->
  <ItemGroup>
    <ShippedCatalogue Include="sources.json" />
    <ShippedMigration Include="Storage\Migrations\*.sql" />
  </ItemGroup>

  <Target Name="WriteShippedFiles"
          BeforeTargets="BeforeCompile"
          Inputs="@(ShippedCatalogue);@(ShippedMigration);$(MSBuildThisFileFullPath)"
          Outputs="$(IntermediateOutputPath)ShippedFiles.g.cs">
    <PropertyGroup>
      <ShippedFilesSource>$(IntermediateOutputPath)ShippedFiles.g.cs</ShippedFilesSource>
      <!-- A raw string's fence: longer than any run of quotes in a source or a migration. -->
      <ShippedFence>&quot;&quot;&quot;&quot;</ShippedFence>
    </PropertyGroup>

    <WriteLinesToFile File="$(ShippedFilesSource)"
                      Overwrite="true"
                      Lines="// Written by the build from sources.json and Storage/Migrations. Edit those, not this.;namespace NoMercy.Plugin.TorrentDownloader%3B;internal static class ShippedFiles;{;public const string Catalogue = $(ShippedFence)" />
    <WriteLinesToFile File="$(ShippedFilesSource)"
                      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(ShippedCatalogue.FullPath)'))))" />
    <WriteLinesToFile File="$(ShippedFilesSource)"
                      Lines="$(ShippedFence)%3B;public static readonly (string Name, string Sql)[] Migrations =;[" />
    <WriteLinesToFile File="$(ShippedFilesSource)"
                      Lines="(&quot;%(ShippedMigration.Filename)%(ShippedMigration.Extension)&quot;, $(ShippedFence);$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(ShippedMigration.FullPath)'))));$(ShippedFence))," />
    <WriteLinesToFile File="$(ShippedFilesSource)"
                      Lines="]%3B;}" />
  </Target>

  <!-- Its own target, so the file is compiled whether or not it was up to date and rewritten. -->
  <Target Name="CompileShippedFiles" AfterTargets="WriteShippedFiles" BeforeTargets="BeforeCompile">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ShippedFiles.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)ShippedFiles.g.cs" />
    </ItemGroup>
  </Target>

</Project>
