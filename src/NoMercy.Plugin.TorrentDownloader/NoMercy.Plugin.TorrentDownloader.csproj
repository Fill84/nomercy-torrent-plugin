<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AssemblyName>NoMercy.Plugin.TorrentDownloader</AssemblyName>
        <RootNamespace>NoMercy.Plugin.TorrentDownloader</RootNamespace>
        <Version>0.1.0</Version>
        <Authors>Phillippe Pelzer</Authors>
        <Description>Keeps a TV library complete by downloading missing episodes over BitTorrent.</Description>

        <!--
            A library build leaves its NuGet dependencies in the package cache and lists
            them in deps.json, which is right for something another project references and
            wrong for a plugin: nothing composes this, it is copied into a folder and loaded
            from there. The host's load context resolves dependencies out of that folder, so
            they have to be in it.

            Only mattered once PuppeteerSharp arrived - before that every dependency was one
            the host already owned.
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

        <!--
            Which brings the host's own assemblies along with it, and those must never be
            copied: they live in the server's shared-assembly set, and a second copy beside
            the plugin is a second identity of the same type across the load-context
            boundary. CI fails the build when it sees one in the output, which is how this
            was caught.

            The host packages are marked below. That keeps them as compile
            references and as deps.json entries - which is what the load context reads - and
            stops them being written next to the plugin.
        -->
    </PropertyGroup>

    <ItemGroup>
        <!--
            The host owns this assembly at runtime: it is in the server's shared-assembly
            set, so the plugin load context deliberately resolves it to the host's copy
            rather than to one sitting next to the plugin.

            This is a library, so NuGet runtime assets are not copied to the output
            directory and the built folder is already free of it. Do NOT set
            CopyLocalLockFileAssemblies=true here to "gather dependencies" for packaging:
            it would drop NoMercy.Plugins.Abstractions.dll and NoMercy.Events.dll beside
            the plugin, and the load context would then hold two incompatible identities
            of the same types. That failure surfaces as an unrelated-looking cast error
            far from its cause. The CI packaging step asserts neither assembly ships.

            ExcludeAssets="runtime" is also wrong: it would stop the test project from
            resolving the assembly at run time, and the tests would fail to load.
        -->
        <PackageReference Include="NoMercy.Plugins.Abstractions" Version="*" />

        <!--
            PluginControllerBase, which this plugin's REST controllers inherit. Also
            host-owned and also in the shared set, for the same load-context reason: a
            base class the host resolves must have exactly one identity.
        -->
        <PackageReference Include="NoMercy.Plugins.Mvc" Version="*" />
        <PackageReference Include="PuppeteerSharp" Version="25.5.0" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Required by NoMercy.Plugins.Mvc, which derives from ControllerBase. The server is
            an ASP.NET Core app and provides this at run time, so it is a FrameworkReference
            rather than anything shipped beside the plugin.
        -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NoMercy.Plugin.TorrentDownloader.Core\NoMercy.Plugin.TorrentDownloader.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="plugin.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
        The host's assemblies, out of the copy-local set.

        <para>
        CopyLocalLockFileAssemblies is what puts PuppeteerSharp beside the plugin, and it is
        indiscriminate: it copies every assembly in the lock file, including the ones the
        server owns. A second copy of those next to the plugin is a second identity of the
        same type across the load-context boundary, and the failure surfaces as an unrelated
        cast error far from its cause. Private="false" on the PackageReference does not stop
        it - that governs the direct reference, not the lock-file sweep.
        </para>

        <para>
        The list is PluginHostOptions.DefaultSharedAssemblies on the server side: what the
        load context deliberately resolves to the host's copy. CI asserts two of them never
        ship; the rest are just as wrong and are removed for the same reason.
        </para>
    -->
    <Target Name="LeaveTheHostsAssembliesToTheHost" AfterTargets="ResolveReferences">
        <ItemGroup>
            <ReferenceCopyLocalPaths
                Remove="@(ReferenceCopyLocalPaths)"
                Condition="'%(Filename)' == 'NoMercy.Plugins.Abstractions'
                        or '%(Filename)' == 'NoMercy.Plugins.Mvc'
                        or '%(Filename)' == 'NoMercy.Events'
                        or '%(Filename)' == 'NoMercy.Design'
                        or '%(Filename)' == 'Newtonsoft.Json'
                        or '%(Filename)' == 'Ulid'
                        or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.'))" />
        </ItemGroup>
    </Target>

</Project>
